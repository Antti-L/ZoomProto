*-----------------------------------------------------------------------------
* INIT_ext.zon - Extension for period-wise Region Zooming
*-----------------------------------------------------------------------------

* Internal attributes
  SET ZR0(REG) 'R0 regions' //;
  SET ZRZ(REG) 'Sub-regions' //;
  SET Z0RZ(ALL_R) 'Zoomed R0 regions' //;
  SET RTREG(REG,YEAR,REG,L) //;
  SET RT_ZON(R,T) //;
  SET REG_TZON(R,T);
  SET ZRSR(REG,REG) 'Map of R0 region to its subregions' //;
  SET RP_COM(REG,PRC,COM);
  SET ZTP_PASTI(R,YEAR,P);
  SET ZTPS_ACT(R,YEAR,P,S);
  SET ZTPCS_FLO(R,T,P,C,S,IO);
  SET ZTCS_AGG(R,T,C,S,LIM);
  SET ZRT_PP(R,T);
  PARAMETER ZR_ZLV(ALL_R) //;
  PARAMETER MI_DOPE(R,T,C) demand //;
  SET UC_RN(UC_N,ALL_R) //;
  PARAMETER RP_RTF(R,P);
  ALIAS(REG,RGN);
*-------------------------------------------------------------------------------
* Get all R0 regions
  REG_ZOOM(R,'0') = SMAX(DATAYEAR$REG_ZOOM(R,DATAYEAR),REG_ZOOM(R,DATAYEAR));
  REG_ZOOM(R,'0') = MAX(0,MIN(3,ROUND(REG_ZOOM(R,'0'))));
  REG_SRMAP(R,R)=NO;
  Z0RZ(R)$(NOT SUM(REG_SRMAP(REG,R),1))=YES;

* Count zoom levels for all in the map
  ZR_ZLV(Z0RZ)=EPS;
  LOOP(Z0RZ(R), ZR_ZLV(ALL_REG)$((NOT ZR_ZLV(ALL_REG))$REG_SRMAP(R,ALL_REG)) = 1);
  OPTION CLEAR=Z0RZ; Z0RZ(ALL_R)$(ZR_ZLV(ALL_R)=1) = YES;
  LOOP(Z0RZ(ALL_R), ZR_ZLV(ALL_REG)$((NOT ZR_ZLV(ALL_REG))$REG_SRMAP(ALL_R,ALL_REG)) = 2);
  OPTION CLEAR=Z0RZ; Z0RZ(ALL_R)$(ZR_ZLV(ALL_R)=2) = YES;
  LOOP(Z0RZ(ALL_R), ZR_ZLV(ALL_REG)$((NOT ZR_ZLV(ALL_REG))$REG_SRMAP(ALL_R,ALL_REG)) = 3);

* Complete map
  Z0RZ(R) = (ZR_ZLV(R)=0);
  REG_SRMAP(Z0RZ(ALL_R),REG)$SUM(REG_SRMAP(ALL_R,ALL_REG),REG_SRMAP(ALL_REG,REG)) = YES;
  REG_SRMAP(Z0RZ(ALL_R),REG)$SUM(REG_SRMAP(ALL_R,ALL_REG),REG_SRMAP(ALL_REG,REG)) = YES;
  REG_SRMAP(ALL_R,ALL_R)=NO;

  LOOP(Z0RZ(R), Z=SMAX(REG_SRMAP(R,REG),ZR_ZLV(REG)); F=MIN(Z,REG_ZOOM(R,'0'));
    IF(F>0, ZRSR(R,REG)$((ZR_ZLV(REG)=F)$REG_SRMAP(R,REG))=YES;
    ELSE REG_ZOOM(R,'0')=0));
  ZR0(R) $= Z0RZ(R);
  ZRZ(R) $= SUM(ZRSR(ZR0,R),1);
  Z0RZ(ZR0) = REG_ZOOM(ZR0,'0');
*-------------------------------------------------------------------------------
* Remove eventual inactive regions
  OPTION CLEAR=UNCD1;  UNCD1(R)=YES; UNCD1(ZR0)=NO; UNCD1(ZRZ)=NO;
  TOP(R(ALL_R(UNCD1)),P,C,IO)=NO;
  TOP_IRE(ALL_REG(UNCD1),C,ALL_R,COM,P)=NO;
  TOP_IRE(ALL_R,COM,ALL_REG(UNCD1),C,P)=NO;
  COM_AGG(R(ALL_R(UNCD1)),LL,C,COM)=0;
  OPTION CLEAR=UNCD1; 
*-------------------------------------------------------------------------------
* Clone basic sets
  OPTION PRC_ACT < PRC_ACTUNT;
  LOOP(ZR0(REG),
    COM_DESC(R,C)$ZRSR(REG,R) $= COM_DESC(REG,C);
    COM_LIM(R,C,L)$ZRSR(REG,R) $= COM_LIM(REG,C,L);
    COM_PEAK(R,CG)$ZRSR(REG,R) $= COM_PEAK(REG,CG);
    COM_PKTS(R,CG,S)$ZRSR(REG,R) $= COM_PKTS(REG,CG,S);
    COM_TMAP(R,COM_TYPE,C)$ZRSR(REG,R) $= COM_TMAP(REG,COM_TYPE,C);
    COM_TSL(R,C,TSL)$ZRSR(REG,R) $= COM_TSL(REG,C,TSL);
    COM_GMAP(R,CG,C)$ZRSR(REG,R) $= COM_GMAP(REG,CG,C);
    NRG_TMAP(R,NRG_TYPE,C)$ZRSR(REG,R) $= NRG_TMAP(REG,NRG_TYPE,C);
* Remove any PCG from subregions if defined for parent region
    PRC_ACTUNT(R,P,CG,UNITS_ACT)$(PRC_ACT(REG,P)$ZRSR(REG,R)) = NO;
    PRC_ACTUNT(R,P,CG,UNITS_ACT)$ZRSR(REG,R) $= PRC_ACTUNT(REG,P,CG,UNITS_ACT);
    PRC_CAPUNT(R,P,CG,UNITS_CAP)$ZRSR(REG,R) $= PRC_CAPUNT(REG,P,CG,UNITS_CAP);
    PRC_AOFF(R,P,BOHYEAR,EOHYEAR) $= PRC_AOFF(REG,P,BOHYEAR,EOHYEAR);
    PRC_FOFF(R,P,C,S,BOHYEAR,EOHYEAR) $= PRC_FOFF(REG,P,C,S,BOHYEAR,EOHYEAR);
    PRC_NOFF(R,P,BOHYEAR,EOHYEAR) $= PRC_NOFF(REG,P,BOHYEAR,EOHYEAR);
    PRC_DESC(R,P) $= PRC_DESC(REG,P);
    PRC_MAP(R,PRC_GRP,P) $= PRC_MAP(REG,PRC_GRP,P);
    PRC_NSTTS(R,P,S) $= PRC_NSTTS(REG,P,S);
    PRC_PKAF(R,P) $= PRC_PKAF(REG,P);
    PRC_PKNO(R,P) $= PRC_PKNO(REG,P);
    PRC_TSL(R,P,TSL) $= PRC_TSL(REG,P,TSL);
    PRC_VINT(R,P) $= PRC_VINT(REG,P);
    PRC_STGTSS(R,P,C)$ZRSR(REG,R) $= PRC_STGTSS(REG,P,C);
$IF DEFINED PRC_RCAP PRC_RCAP(R,P) $= PRC_RCAP(REG,P);
* Ensure topology will be same
    TOP(PRC_DESC(R,P),C,IO)$ZRSR(REG,R) = NO;
    TOP(R,P,C,IO)$ZRSR(REG,R) $= TOP(REG,P,C,IO);
    OPTION RP_GRP < PRC_ACTUNT;
    PRC_ACTUNT(R,P,CG,UNITS_ACT)$((NOT RP_GRP(REG,P,CG))$ZRSR(REG,R)) = NO;
    PRC_ACTUNT(RP_GRP(R,P,CG),UNITS_ACT)$ZRSR(REG,R) $= PRC_ACTUNT(REG,P,CG,UNITS_ACT);
    LOOP(ZRSR(REG,R)$(NOT SUM(TS_MAP(R,TS,S),1)),
      TS_GROUP(R,TSL,S) $= TS_GROUP(REG,TSL,S);
      TS_MAP(R,TS,S)    $= TS_MAP(REG,TS,S)));

* Maybe allow some user defined links
  TOP_IRE(ZR0(R),C,ZRZ(REG),COM,P)$Z0RZ(R)=NO;
  TOP_IRE(ZRZ(R),C,ZR0(REG),COM,P)$Z0RZ(REG)=NO;
  LOOP(ZR0(R),
    TOP_IRE('IMPEXP',C,ZRZ(REG),COM,P)$SUM(TOP_IRE(ALL_R,C,R,COM,P)$ZRSR(R,REG),1)=YES;
    TOP_IRE(ZRZ(REG),C,'IMPEXP',COM,P)$SUM(TOP_IRE(R,C,ALL_R,COM,P)$ZRSR(R,REG),1)=YES);

*-------------------------------------------------------------------------------
* TID attributes 
  LOOP(ZR0(REG),
    LOOP(ZRSR(REG,R)$(NOT SUM(S$G_YRFR(R,S),1)),G_YRFR(R,S) $= G_YRFR(REG,S));
    REG_FIXT(R)$((NOT REG_FIXT(R))$ZRSR(REG,R)) $= REG_FIXT(REG);
$IF DEFINED R_CUREX R_CUREX(R,CUR,CURR)$((NOT R_CUREX(R,CUR,CURR))$ZRSR(REG,R)) $= R_CUREX(REG,CUR,CURR);
    COM_STEP(R,C,L)$((NOT COM_STEP(R,C,L))$ZRSR(REG,R)) $= COM_STEP(REG,C,L);
    NCAP_START(R,P)$((NOT NCAP_START(R,P))$ZRSR(REG,R)) $= NCAP_START(REG,P);      
    PRC_CAPACT(R,P)$((NOT PRC_CAPACT(R,P))$ZRSR(REG,R)) $= PRC_CAPACT(REG,P);
  );

*-------------------------------------------------------------------------------
* TS Attributes -- lots of
* (REG,COM)
  OPTION FIN < COM_CSTNET; LOOP(ZR0(REG), COM_CSTNET(R,YEAR,C,S,CUR)$(NOT FIN(R,C)) $= COM_CSTNET(REG,YEAR,C,S,CUR)$ZRSR(REG,R));
  OPTION FIN < COM_CSTPRD; LOOP(ZR0(REG), COM_CSTPRD(R,YEAR,C,S,CUR)$(NOT FIN(R,C)) $= COM_CSTPRD(REG,YEAR,C,S,CUR)$ZRSR(REG,R));
  OPTION FIN < COM_SUBNET; LOOP(ZR0(REG), COM_SUBNET(R,YEAR,C,S,CUR)$(NOT FIN(R,C)) $= COM_SUBNET(REG,YEAR,C,S,CUR)$ZRSR(REG,R));
  OPTION FIN < COM_SUBPRD; LOOP(ZR0(REG), COM_SUBPRD(R,YEAR,C,S,CUR)$(NOT FIN(R,C)) $= COM_SUBPRD(REG,YEAR,C,S,CUR)$ZRSR(REG,R));
  OPTION FIN < COM_TAXNET; LOOP(ZR0(REG), COM_TAXNET(R,YEAR,C,S,CUR)$(NOT FIN(R,C)) $= COM_TAXNET(REG,YEAR,C,S,CUR)$ZRSR(REG,R));
  OPTION FIN < COM_TAXPRD; LOOP(ZR0(REG), COM_TAXPRD(R,YEAR,C,S,CUR)$(NOT FIN(R,C)) $= COM_TAXPRD(REG,YEAR,C,S,CUR)$ZRSR(REG,R));
  OPTION FIN < COM_ELAST;  LOOP(ZR0(REG), COM_ELAST(R,YEAR,C,S,L)$(NOT FIN(R,C))    $= COM_ELAST(REG,YEAR,C,S,L)$ZRSR(REG,R));
  OPTION FIN < COM_FR;     LOOP(ZR0(REG), COM_FR(R,YEAR,C,S)$(NOT FIN(R,C))         $= COM_FR(REG,YEAR,C,S)$ZRSR(REG,R));
  OPTION FIN < COM_IE;     LOOP(ZR0(REG), COM_IE(R,YEAR,C,S)$(NOT FIN(R,C))         $= COM_IE(REG,YEAR,C,S)$ZRSR(REG,R));
  OPTION FIN < COM_PKFLX;  LOOP(ZR0(REG), COM_PKFLX(R,YEAR,C,S)$(NOT FIN(R,C))      $= COM_PKFLX(REG,YEAR,C,S)$ZRSR(REG,R));
  OPTION FIN < COM_PKRSV;  LOOP(ZR0(REG), COM_PKRSV(R,YEAR,C)$(NOT FIN(R,C))        $= COM_PKRSV(REG,YEAR,C)$ZRSR(REG,R));
  OPTION FIN < COM_VOC;    LOOP(ZR0(REG), COM_VOC(R,YEAR,C,BD)$(NOT FIN(R,C))       $= COM_VOC(REG,YEAR,C,BD)$ZRSR(REG,R));
  OPTION MI_DMAS<=COM_AGG;  LOOP(ZR0(REG),COM_AGG(R,YEAR,C,COM)$(NOT MI_DMAS(R,C,COM))  $= COM_AGG(REG,YEAR,C,COM)$ZRSR(REG,R));
  OPTION MI_DMAS<=VDA_EMCB; LOOP(ZR0(REG),VDA_EMCB(R,YEAR,C,COM)$(NOT MI_DMAS(R,C,COM)) $= VDA_EMCB(REG,YEAR,C,COM)$ZRSR(REG,R));

* (REG,PRC)
  OPTION PRC_ACT < ACT_COST;   LOOP(ZR0(REG), ACT_COST(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P))  $= ACT_COST(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_COST;  LOOP(ZR0(REG), NCAP_COST(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P)) $= NCAP_COST(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_DCOST; LOOP(ZR0(REG), NCAP_DCOST(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P))$= NCAP_DCOST(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_DLAGC; LOOP(ZR0(REG), NCAP_DLAGC(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P))$= NCAP_DLAGC(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FOM;   LOOP(ZR0(REG), NCAP_FOM(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P))  $= NCAP_FOM(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FSUB;  LOOP(ZR0(REG), NCAP_FSUB(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P)) $= NCAP_FSUB(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FTAX;  LOOP(ZR0(REG), NCAP_FTAX(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P)) $= NCAP_FTAX(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_ISUB;  LOOP(ZR0(REG), NCAP_ISUB(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P)) $= NCAP_ISUB(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_ITAX;  LOOP(ZR0(REG), NCAP_ITAX(R,YEAR,P,CUR)$(NOT PRC_ACT(R,P)) $= NCAP_ITAX(REG,YEAR,P,CUR)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_BPME;  LOOP(ZR0(REG), NCAP_BPME(R,YEAR,P)$(NOT PRC_ACT(R,P))     $= NCAP_BPME(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_CDME;  LOOP(ZR0(REG), NCAP_CDME(R,YEAR,P)$(NOT PRC_ACT(R,P))     $= NCAP_CDME(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_CEH;   LOOP(ZR0(REG), NCAP_CEH(R,YEAR,P)$(NOT PRC_ACT(R,P))      $= NCAP_CEH(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_CHPR;  LOOP(ZR0(REG), NCAP_CHPR(R,YEAR,P,BD)$(NOT PRC_ACT(R,P))  $= NCAP_CHPR(REG,YEAR,P,BD)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_CPX;   LOOP(ZR0(REG), NCAP_CPX(R,YEAR,P)$(NOT PRC_ACT(R,P))      $= NCAP_CPX(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_DELIF; LOOP(ZR0(REG), NCAP_DELIF(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_DELIF(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_DLAG;  LOOP(ZR0(REG), NCAP_DLAG(R,YEAR,P)$(NOT PRC_ACT(R,P))     $= NCAP_DLAG(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_DLIFE; LOOP(ZR0(REG), NCAP_DLIFE(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_DLIFE(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_DRATE; LOOP(ZR0(REG), NCAP_DRATE(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_DRATE(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_ELIFE; LOOP(ZR0(REG), NCAP_ELIFE(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_ELIFE(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FDR;   LOOP(ZR0(REG), NCAP_FDR(R,YEAR,P)$(NOT PRC_ACT(R,P))      $= NCAP_FDR(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FOMM;  LOOP(ZR0(REG), NCAP_FOMM(R,YEAR,P)$(NOT PRC_ACT(R,P))     $= NCAP_FOMM(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FOMX;  LOOP(ZR0(REG), NCAP_FOMX(R,YEAR,P)$(NOT PRC_ACT(R,P))     $= NCAP_FOMX(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FSUBM; LOOP(ZR0(REG), NCAP_FSUBM(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_FSUBM(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FSUBX; LOOP(ZR0(REG), NCAP_FSUBX(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_FSUBX(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FTAXM; LOOP(ZR0(REG), NCAP_FTAXM(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_FTAXM(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_FTAXX; LOOP(ZR0(REG), NCAP_FTAXX(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_FTAXX(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_ILED;  LOOP(ZR0(REG), NCAP_ILED(R,YEAR,P)$(NOT PRC_ACT(R,P))     $= NCAP_ILED(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_ISPCT; LOOP(ZR0(REG), NCAP_ISPCT(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_ISPCT(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_PKCNT; LOOP(ZR0(REG), NCAP_PKCNT(R,YEAR,P,S)$(NOT PRC_ACT(R,P))  $= NCAP_PKCNT(REG,YEAR,P,S)$ZRSR(REG,R));
  OPTION PRC_ACT < NCAP_TLIFE; LOOP(ZR0(REG), NCAP_TLIFE(R,YEAR,P)$(NOT PRC_ACT(R,P))    $= NCAP_TLIFE(REG,YEAR,P)$ZRSR(REG,R));
$IF DEFINED PRC_REFIT OPTION PRC_ACT < PRC_REFIT;  LOOP(ZR0(REG), PRC_REFIT(R,PRC,P)$(NOT PRC_ACT(R,P))      $= PRC_REFIT(REG,PRC,P)$ZRSR(REG,R));
  OPTION PRC_ACT < STG_EFF;    LOOP(ZR0(REG), STG_EFF(R,YEAR,P)$(NOT PRC_ACT(R,P))       $= STG_EFF(REG,YEAR,P)$ZRSR(REG,R));
  OPTION PRC_ACT < STG_LOSS;   LOOP(ZR0(REG), STG_LOSS(R,YEAR,P,S)$(NOT PRC_ACT(R,P))    $= STG_LOSS(REG,YEAR,P,S)$ZRSR(REG,R));
$IF DEFINED RCAP_BND OPTION PRC_ACT < RCAP_BND; LOOP(ZR0(REG),RCAP_BND(R,'0',P,'N')$PRC_ACT(R,P) = 1);

* (REG,PRC,COM)
  OPTION RP_COM < FLO_COST;  LOOP(ZR0(REG), FLO_COST(R,YEAR,P,C,S,CUR)$(NOT RP_COM(R,P,C))  $= FLO_COST(REG,YEAR,P,C,S,CUR)$ZRSR(REG,R));
  OPTION RP_COM < FLO_DELIV; LOOP(ZR0(REG), FLO_DELIV(R,YEAR,P,C,S,CUR)$(NOT RP_COM(R,P,C)) $= FLO_DELIV(REG,YEAR,P,C,S,CUR)$ZRSR(REG,R));
  OPTION RP_COM < FLO_EFF;   LOOP(ZR0(REG), FLO_EFF(R,YEAR,P,CG,C,S)$(NOT RP_COM(R,P,C))    $= FLO_EFF(REG,YEAR,P,CG,C,S)$ZRSR(REG,R));
  OPTION RP_COM < FLO_EMIS;  LOOP(ZR0(REG), FLO_EMIS(R,YEAR,P,CG,C,S)$(NOT RP_COM(R,P,C))   $= FLO_EMIS(REG,YEAR,P,CG,C,S)$ZRSR(REG,R));
  OPTION RP_COM < FLO_FR;    LOOP(ZR0(REG), FLO_FR(R,YEAR,P,C,S,L)$(NOT RP_COM(R,P,C))      $= FLO_FR(REG,YEAR,P,C,S,L)$ZRSR(REG,R));
  OPTION RP_COM < FLO_MARK;  LOOP(ZR0(REG), FLO_MARK(R,YEAR,P,C,BD)$(NOT RP_COM(R,P,C))     $= FLO_MARK(REG,YEAR,P,C,BD)$ZRSR(REG,R));
  OPTION RP_COM < FLO_PKCOI; LOOP(ZR0(REG), FLO_PKCOI(R,YEAR,P,C,S)$(NOT RP_COM(R,P,C))     $= FLO_PKCOI(REG,YEAR,P,C,S)$ZRSR(REG,R));
  OPTION RP_COM < FLO_SUB;   LOOP(ZR0(REG), FLO_SUB(R,YEAR,P,C,S,CUR)$(NOT RP_COM(R,P,C))   $= FLO_SUB(REG,YEAR,P,C,S,CUR)$ZRSR(REG,R));
  OPTION RP_COM < FLO_TAX;   LOOP(ZR0(REG), FLO_TAX(R,YEAR,P,C,S,CUR)$(NOT RP_COM(R,P,C))   $= FLO_TAX(REG,YEAR,P,C,S,CUR)$ZRSR(REG,R));
  OPTION RP_COM < NCAP_CLAG; LOOP(ZR0(REG), NCAP_CLAG(R,YEAR,P,C,IO)$(NOT RP_COM(R,P,C))    $= NCAP_CLAG(REG,YEAR,P,C,IO)$ZRSR(REG,R));
  OPTION RP_COM < NCAP_CLED; LOOP(ZR0(REG), NCAP_CLED(R,YEAR,P,C)$(NOT RP_COM(R,P,C))       $= NCAP_CLED(REG,YEAR,P,C)$ZRSR(REG,R));
  OPTION RP_COM < NCAP_COM;  LOOP(ZR0(REG), NCAP_COM(R,YEAR,P,C,IO)$(NOT RP_COM(R,P,C))     $= NCAP_COM(REG,YEAR,P,C,IO)$ZRSR(REG,R));
  OPTION RP_COM < NCAP_ICOM; LOOP(ZR0(REG), NCAP_ICOM(R,YEAR,P,C)$(NOT RP_COM(R,P,C))       $= NCAP_ICOM(REG,YEAR,P,C)$ZRSR(REG,R));
  OPTION RP_COM < NCAP_OCOM; LOOP(ZR0(REG), NCAP_OCOM(R,YEAR,P,C)$(NOT RP_COM(R,P,C))       $= NCAP_OCOM(REG,YEAR,P,C)$ZRSR(REG,R));
  OPTION RP_COM < NCAP_VALU; LOOP(ZR0(REG), NCAP_VALU(R,YEAR,P,C,CUR)$(NOT RP_COM(R,P,C))   $= NCAP_VALU(REG,YEAR,P,C,CUR)$ZRSR(REG,R));
  OPTION RP_COM < IRE_FLOSUM;LOOP(ZR0(REG), IRE_FLOSUM(R,YEAR,P,C,S,IE,COM,IO)$((NOT RP_COM(R,P,C))$ZRSR(REG,R))  $= IRE_FLOSUM(REG,YEAR,P,C,S,IE,COM,IO));
  OPTION RP_COM < IRE_PRICE; LOOP(ZR0(REG), IRE_PRICE(R,YEAR,P,C,S,R,IE,CUR)$((NOT RP_COM(R,P,C))$ZRSR(REG,R))  $= IRE_PRICE(REG,YEAR,P,C,S,REG,IE,CUR));
  OPTION RP_CCG < FLO_SHAR;  LOOP(ZR0(REG), FLO_SHAR(R,YEAR,P,C,CG,S,BD)$(NOT RP_CCG(R,P,C,CG))$= FLO_SHAR(REG,YEAR,P,C,CG,S,BD)$ZRSR(REG,R));
  OPTION PRC_ACT < PRC_MARK; LOOP(ZR0(REG), PRC_MARK(R,YEAR,P,ITEM,C,L)$(NOT PRC_ACT(R,P))  $= PRC_MARK(REG,YEAR,P,ITEM,C,L)$ZRSR(REG,R));
  OPTION TRACKPC < STG_SIFT;  LOOP(ZR0(REG), STG_SIFT(R,YEAR,P,C,S)$(NOT TRACKPC(R,P,C))      $= STG_SIFT(REG,YEAR,P,C,S)$ZRSR(REG,R));

* (R,P);(REG,PRC,CG)
  OPTION TRACKP < ACT_MINLD;  LOOP(ZR0(REG), ACT_MINLD(R,YEAR,P)$(NOT TRACKP(R,P))     $= ACT_MINLD(REG,YEAR,P)$ZRSR(REG,R));
  OPTION TRACKP < ACT_TIME;   LOOP(ZR0(REG), ACT_TIME(R,YEAR,P,L)$(NOT TRACKP(R,P))    $= ACT_TIME(REG,YEAR,P,L)$ZRSR(REG,R));
  OPTION TRACKP < ACT_UPS;    LOOP(ZR0(REG), ACT_UPS(R,YEAR,P,S,L)$(NOT TRACKP(R,P))   $= ACT_UPS(REG,YEAR,P,S,L)$ZRSR(REG,R));
  OPTION TRACKP < ACT_CSTUP;  LOOP(ZR0(REG), ACT_CSTUP(R,YEAR,P,TSL,CUR)$(NOT TRACKP(R,P))   $= ACT_CSTUP(REG,YEAR,P,TSL,CUR)$ZRSR(REG,R));
  OPTION TRACKP < ACT_CSTRMP; LOOP(ZR0(REG), ACT_CSTRMP(R,YEAR,P,BD,CUR)$(NOT TRACKP(R,P))   $= ACT_CSTRMP(REG,YEAR,P,BD,CUR)$ZRSR(REG,R));
  OPTION TRACKP < NCAP_AFM;   LOOP(ZR0(REG), NCAP_AFM(R,YEAR,P)$(NOT TRACKP(R,P))      $= NCAP_AFM(REG,YEAR,P)$ZRSR(REG,R));
  OPTION TRACKP < NCAP_AFX;   LOOP(ZR0(REG), NCAP_AFX(R,YEAR,P)$(NOT TRACKP(R,P))      $= NCAP_AFX(REG,YEAR,P)$ZRSR(REG,R));
  OPTION TRACKP < STG_MAXCYC; LOOP(ZR0(REG), STG_MAXCYC(R,YEAR,P)$(NOT TRACKP(R,P))       $= STG_MAXCYC(REG,YEAR,P)$ZRSR(REG,R));
  OPTION TRACKP < NCAP_AFSX;  LOOP(ZR0(REG), NCAP_AFSX(R,YEAR,P,BD)$(NOT TRACKP(R,P))     $= NCAP_AFSX(REG,YEAR,P,BD)$ZRSR(REG,R));
  OPTION RP_AFB < NCAP_AF;    LOOP(ZR0(REG), NCAP_AF(R,YEAR,P,S,BD)$(NOT RP_AFB(R,P,BD))  $= NCAP_AF(REG,YEAR,P,S,BD)$ZRSR(REG,R));
  OPTION RP_AFB < NCAP_AFS;   LOOP(ZR0(REG), NCAP_AFS(R,YEAR,P,S,BD)$(NOT RP_AFB(R,P,BD)) $= NCAP_AFS(REG,YEAR,P,S,BD)$ZRSR(REG,R));
  OPTION RP_AFB < NCAP_AFA;   LOOP(ZR0(REG), NCAP_AFA(R,YEAR,P,BD)$(NOT RP_AFB(R,P,BD))   $= NCAP_AFA(REG,YEAR,P,BD)$ZRSR(REG,R));
  OPTION RP_GRP < ACT_EFF;    LOOP(ZR0(REG), ACT_EFF(R,YEAR,P,CG,S)$(NOT RP_GRP(R,P,CG))     $= ACT_EFF(REG,YEAR,P,CG,S)$ZRSR(REG,R));
  OPTION RP_GRP < ACT_FLO;    LOOP(ZR0(REG), ACT_FLO(R,YEAR,P,CG,S)$(NOT RP_GRP(R,P,CG))     $= ACT_FLO(REG,YEAR,P,CG,S)$ZRSR(REG,R));
  OPTION RP_GRP < FLO_FUNC;   LOOP(ZR0(REG), FLO_FUNC(R,YEAR,P,CG1,CG,S)$(NOT RP_GRP(R,P,CG))$= FLO_FUNC(REG,YEAR,P,CG1,CG,S)$ZRSR(REG,R));
  OPTION RP_GRP < FLO_FUNCX;  LOOP(ZR0(REG), FLO_FUNCX(R,YEAR,P,CG1,CG)$(NOT RP_GRP(R,P,CG)) $= FLO_FUNCX(REG,YEAR,P,CG1,CG)$ZRSR(REG,R));
  OPTION RP_GRP < NCAP_AFAC;  LOOP(ZR0(REG), NCAP_AFAC(R,YEAR,P,CG)$(NOT RP_GRP(R,P,CG))     $= NCAP_AFAC(REG,YEAR,P,CG)$ZRSR(REG,R));
  OPTION RP_GRP < NCAP_AFC;   LOOP(ZR0(REG), NCAP_AFC(R,YEAR,P,CG,STL)$(NOT RP_GRP(R,P,CG))  $= NCAP_AFC(REG,YEAR,P,CG,STL)$ZRSR(REG,R));
  OPTION RP_GRP < NCAP_AFCS;  LOOP(ZR0(REG), NCAP_AFCS(R,YEAR,P,CG,S)$(NOT RP_GRP(R,P,CG))   $= NCAP_AFCS(REG,YEAR,P,CG,S)$ZRSR(REG,R));
  OPTION RP_GRP < PRC_ACTFLO; LOOP(ZR0(REG), PRC_ACTFLO(R,YEAR,P,CG)$(NOT RP_GRP(R,P,CG))    $= PRC_ACTFLO(REG,YEAR,P,CG)$ZRSR(REG,R));
  OPTION RP_GRP < VDA_FLOP;   LOOP(ZR0(REG), VDA_FLOP(R,YEAR,P,CG,S)$(NOT RP_GRP(R,P,CG))    $= VDA_FLOP(REG,YEAR,P,CG,S)$ZRSR(REG,R));


  LOOP(ZRSR(REG,R),
    IF(NOT SUM((YEAR,CUR)$G_DRATE(R,YEAR,CUR),1), G_DRATE(R,YEAR,CUR)$=G_DRATE(REG,YEAR,CUR));
    IF(NOT SUM(YEAR$G_RFRIR(R,YEAR),1), G_RFRIR(R,YEAR)$=G_RFRIR(REG,YEAR)));

* Get SR pastis and initialize with R0 pastis when missing
  ZTP_PASTI(ZRZ(R),LL,P)$=NCAP_PASTI(R,LL,P);
  LOOP((ZR0(REG),PYR_S(V)),
    NCAP_PASTI(ZRZ(R),LL,P)$(NOT ZTP_PASTI(R,LL,P)$ZRSR(REG,R)) $= NCAP_PASTI(REG,LL,P);
    PRC_RESID(ZRZ(R),T,P)$(NOT ZTP_PASTI(R,V,P)$ZRSR(REG,R)) $= PRC_RESID(REG,T,P));

  OPTION CLEAR=FIN,CLEAR=TRACKP,CLEAR=PRC_ACT,CLEAR=RP_GRP,CLEAR=MI_DMAS,CLEAR=RP_AFB,CLEAR=RP_COM,CLEAR=RP_CCG;

*-----------------------------------------------------------------------------
* Peaking and Storage stuff
  PRC_STGIPS(ZRZ(R),P,C)$(NOT SUM(PRC_ACTUNT(R,P,CG,UNITS_ACT)$(COM_GMAP(R,CG,C)+SAMEAS(CG,C)),1)) = NO;
* Set penalty cost excess storage cycling
  OPTION TRACKP<STG_MAXCYC; RP_PL(TRACKP,'UP')=YES;
  LOOP(TSL(S(ANNUAL)), ACT_UPS(ZRZ(R),LL,P,S,'FX') $= ACT_MINLD(R,LL,P));
  OPTION CLEAR=TRACKP, RP_UPR<ACT_TIME, RP_UPT<ACT_CSTSD;
*-----------------------------------------------------------------------------
* Identify PRC_RESID processes and initialize NCAP_PASTI
  PRC_RESID(ZRZ(R),LL--ORD(LL),P)$((PRC_RESID(R,LL,P)>0)$PRC_RESID(R,LL,P)) = PRC_RESID(R,'0',P)+EPS;
  NCAP_PASTI(ZRZ(R),PYR_S,P)$PRC_RESID(R,'0',P) = 1;
*-----------------------------------------------------------------------------
* Initial Preprocessing of VDA_EMCB and FLO_EMIS
  OPTION CLEAR=RXX;
  VDA_EMCB(ZRZ(R),DATAYEAR,C,COM)$COM_TMAP(R,'ENV',C) = 0;
  LOOP((ZRZ(R),DATAYEAR,C,COM)$VDA_EMCB(R,DATAYEAR,C,COM),RXX(R,C,COM) = YES);
  RXX(ZRZ(R),C,COM)$(NOT COM_TMAP(R,'ENV',COM)) = NO;
  LOOP((TOP(ZRZ(R),P,C,'IN'),RXX(R,C,COM)),FS_EMCB(R,P,COM,C)=YES);
  FS_EMCB(ZRZ(R),P,COM,C)$TOP(R,P,COM,'IN') = NO;
  OPTION TRACKPC <= FS_EMCB; TOP(TRACKPC,'OUT') = YES;
  OPTION CLEAR=RXX, CLEAR=TRACKPC;
  LOOP((ZRZ(R),DATAYEAR,P,CG,C,S)$FLO_EMIS(R,DATAYEAR,P,CG,C,S),RPC_EMIS(R,P,C) = YES);
  RPG_RED(RPC_EMIS(ZRZ(R),P,C),'OUT')$(NOT TOP(R,P,C,'IN')) = YES;
  LOOP((ZRZ(R),DATAYEAR,P,C,S,IE,COM,IO)$(PRC_MAP(R,'IRE',P)$IRE_FLOSUM(R,DATAYEAR,P,C,S,IE,COM,IO)),RPG_RED(R,P,COM,IO) = YES);
*-----------------------------------------------------------------------------
* Initial Preprocessing of VDA_FLOP
  KEEP_FLOF(ZRZ(R),P,C)$VDA_FLOP(R,'%DFLBL%',P,C,'ANNUAL') = YES;
$IFI %SHELL%==ANSWER KEEP_FLOF(ZRZ(R),P,C)$PRC_ACTFLO(R,'%DFLBL%',P,C) = YES;
*-----------------------------------------------------------------------------
OPTION TOP:5:0:1;
OPTION FLO_EMIS:5:0:1;
*display TOP,FLO_EMIS;